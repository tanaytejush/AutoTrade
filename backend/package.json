{
  "name": "@autotrade/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --import ./scripts/load-env.ts watch src/server.ts",
    "build": "tsc",
    "test": "tsx --import ./scripts/test-env.ts --test src/config.test.ts broker/india.test.ts src/data/historical.test.ts src/data/nse-holidays.test.ts src/analysis/analyzer.test.ts src/risk/costs.test.ts src/risk/engine.test.ts src/backtest/engine.test.ts src/strategy/orb.test.ts src/orchestrator/run.test.ts src/orchestrator/signal.test.ts",
    "manual:brokers": "tsx scripts/manual-broker-test.ts",
    "analyze": "tsx scripts/analyze.ts",
    "analyze:all": "tsx scripts/analyze-all.ts",
    "costs": "tsx scripts/costs.ts",
    "backtest:check": "tsx scripts/backtest-check.ts",
    "fetch:backtest-data": "tsx scripts/fetch-backtest-data.ts",
    "backtest:orb": "tsx scripts/backtest-orb.ts"
    ,"bot:paper": "tsx --import ./scripts/load-env.ts scripts/paper-bot.ts"
    ,"bot:signal": "tsx --import ./scripts/load-env.ts scripts/signal-bot.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
